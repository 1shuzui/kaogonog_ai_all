# Backend runtime
SECRET_KEY=civil-demo-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOWED_ORIGINS=*

# Preferred database connection
# 方式一：直接使用 DATABASE_URL
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/kaogong_ai?charset=utf8mb4

# Optional OpenAI-compatible LLM + ASR
# DeepSeek default:
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_ASR_MODEL=

# Backward-compatible Qwen / DashScope names still work:
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_ASR_MODEL=
LLM_TIMEOUT_SECONDS=25

# 方式二：如果你不想用 DATABASE_URL，也可单独配置以下字段
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=kaogong_ai

# WeChat mini program virtual payment
WECHAT_PAY_ENABLED=false
WECHAT_PAY_SCENE=mini_program_virtual
WECHAT_PAY_APPID=replace_with_miniprogram_appid
WECHAT_PAY_REQUEST_TIMEOUT=10
WECHAT_MINIPROGRAM_APP_SECRET=replace_with_miniprogram_app_secret
WECHAT_VIRTUAL_PAY_OFFER_ID=replace_with_offer_id
WECHAT_VIRTUAL_PAY_MODE=short_series_goods
# 0 = production, 1 = sandbox
WECHAT_VIRTUAL_PAY_ENV=1
WECHAT_VIRTUAL_PAY_APP_KEY=replace_with_production_app_key
WECHAT_VIRTUAL_PAY_SANDBOX_APP_KEY=replace_with_sandbox_app_key
WECHAT_VIRTUAL_PAY_PRODUCT_MAP_JSON={"trial_3h":"trial_3h","monthly_1h_day":"monthly_1h_day"}
# Optional override, values are cents. Use this when WeChat item prices differ from subscription_packages.price.
# Example: 0.01 CNY item price = 1 cent.
WECHAT_VIRTUAL_PAY_PRODUCT_PRICE_MAP_JSON={"trial_3h":1,"monthly_1h_day":1}
